# Ignore Python virtual environments
venv/
.env/
.venv/

# Ignore VS Code editor settings
.vscode/

# Ignore Python bytecode cache
__pycache__/
*.py[cod]
*.egg-info/

# Ignore dbt auto-generated and downloaded folders
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/dbt_modules/

# Ignore local testing or temp folders
testing/
.cache/
*.log

# Ignore Terraform state and local files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Ignore Terraform plan files
*.tfplan
*.tfplan.json

# Ignore Terraform diagnostic / local artifacts
terraform/environments/**/provider-schema.json
terraform/environments/**/state-backup.json
terraform/environments/**/terraform-state-list.txt
terraform/environments/**/workflow-*.json
terraform/environments/**/gcp-asset-types.txt
terraform/environments/**/iam-policy.json